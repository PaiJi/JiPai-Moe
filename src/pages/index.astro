---
import clsx from "clsx";

import Layout from "@layouts/Layout.astro";
import { ContainerStyle } from "@utils/define";
import DynamicInfoCard from "@components/home/DynamicInfoCard";
import SimpleSwiper from "@components/Slider";
import swiperImagesJson from "@content/swiperImages.json";
import { QuickLinkSection } from "@components/home/QuickLink";
---

<Layout>
  <section class={clsx("index-swiper overflow-hidden", ContainerStyle)}>
    <SimpleSwiper
      images={swiperImagesJson.index.map((image) => ({
        src: image.link,
        name: image.name,
      }))}
      imgCls="h-[300px]"
      client:load
    />
  </section>

  <DynamicInfoCard client:load />

  <section class={clsx("my-4 grid grid-cols-3 xl:grid-cols-7 gap-4")}>
    <QuickLinkSection />
  </section>
</Layout>
